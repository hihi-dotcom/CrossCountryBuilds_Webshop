# Run caddy from the project root directory:
#   cd /path/to/CrossCountryBuilds_Webshop
#   caddy run --config Caddyfile --adapter caddyfile
#
# Or with docker compose:
#   docker compose up

{
    admin off
}

:80 {
    # API requests -> proxy to Odin backend
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Product images -> serve from product_images volume
    handle_path /product_images/* {
        root * /var/www/product_images
        file_server
    }

    # Uploaded images -> serve from uploads volume
    handle /uploads/* {
        uri strip_prefix /uploads
        root * /var/www/uploads
        file_server
    }

    # Frontend static files
    handle {
        root * /var/www/frontend/dist
        try_files {path} /index.html
        file_server
    }
}